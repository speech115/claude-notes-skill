def ensure_file(path: Path, label: str) -> Path:
    resolved = path.expanduser().resolve()
    if not resolved.is_file():
        raise FileNotFoundError(f"{label} not found: {resolved}")
    return resolved


def ensure_dir(path: Path, label: str) -> Path:
    resolved = path.expanduser().resolve()
    if not resolved.is_dir():
        raise FileNotFoundError(f"{label} not found: {resolved}")
    return resolved


def ensure_parent_dir(path: Path) -> Path:
    resolved = path.expanduser().resolve()
    resolved.mkdir(parents=True, exist_ok=True)
    return resolved




def resolve_digest_runner() -> Path:
    override = os.environ.get("NOTES_RUNNER_DIGEST_RUNNER")
    if override:
        resolved = Path(override).expanduser()
        if not resolved.is_file():
            raise FileNotFoundError(f"NOTES_RUNNER_DIGEST_RUNNER points to a missing file: {resolved}")
        return resolved

    found = shutil.which("digest-runner")
    if found:
        return Path(found)

    raise FileNotFoundError(
        advanced_setup_message(
            "Telegram delivery",
            "Install a compatible digest-runner and set NOTES_RUNNER_DIGEST_RUNNER if it is not in PATH",
        )
    )


def slugify(value: str, *, max_length: int = 72) -> str:
    normalized = unicodedata.normalize("NFKD", value)
    ascii_text = normalized.encode("ascii", "ignore").decode("ascii").lower()
    slug = re.sub(r"[^a-z0-9]+", "-", ascii_text).strip("-")
    if not slug:
        slug = "notes"
    return slug[:max_length].rstrip("-") or "notes"


def human_folder_name(value: str, *, max_length: int = 96) -> str:
    text = unicodedata.normalize("NFKC", str(value or "")).strip()
    text = re.sub(r"[\\/:*?\"<>|\x00-\x1f]+", " ", text)
    text = re.sub(r"[_]+", " ", text)
    text = re.sub(r"\s+", " ", text).strip(" .")
    if not text:
        text = "Конспект"
    if len(text) <= max_length:
        return text
    trimmed = text[:max_length].rsplit(" ", 1)[0].strip(" .")
    return trimmed or text[:max_length].strip(" .") or "Конспект"


def bundle_identity_matches(bundle_dir: Path, identity: dict[str, str]) -> bool:
    if not identity:
        return False
    metadata = load_json_if_exists(bundle_dir / "metadata.json") or {}
    state = load_json_if_exists(bundle_dir / "run.json") or {}
    for key, expected in identity.items():
        if not expected:
            continue
        for source in (metadata, state):
            actual = str(source.get(key) or "").strip()
            if actual and actual == expected:
                return True
    return False


def unique_human_bundle_dir(output_root: Path, base_name: str, *, identity: dict[str, str] | None = None) -> Path:
    base = human_folder_name(base_name)
    candidate = output_root / base
    if not candidate.exists() or bundle_identity_matches(candidate, identity or {}):
        return candidate
    for index in range(2, 1000):
        candidate = output_root / f"{base} ({index})"
        if not candidate.exists() or bundle_identity_matches(candidate, identity or {}):
            return candidate
    raise ValueError(f"Could not choose an unused output folder name for: {base}")


def bundle_dir_for(metadata: dict, output_root: Path) -> Path:
    video_id = str(metadata.get("id") or "").strip()
    title = str(metadata.get("title") or video_id or "youtube-notes").strip()
    return unique_human_bundle_dir(
        output_root,
        title,
        identity={
            "id": video_id,
            "video_id": video_id,
            "webpage_url": str(metadata.get("webpage_url") or "").strip(),
            "source_url": str(metadata.get("webpage_url") or "").strip(),
        },
    )


def local_bundle_dir_for(source_path: Path, title: str, output_root: Path) -> Path:
    resolved = str(source_path.expanduser().resolve())
    return unique_human_bundle_dir(output_root, title, identity={"source_path": resolved})


